# .env.example — copy to .env and fill all values before deploying

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://isp_user:CHANGE_ME@postgres:5432/isp_db
DB_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=generate-with-openssl-rand-hex-64
AGENT_JWT_SECRET=generate-with-openssl-rand-hex-64
SUPERADMIN_JWT_SECRET=generate-with-openssl-rand-hex-64
SA_SECRET=generate-with-openssl-rand-hex-64

# ── Anthropic (AI assistant) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe (card payments) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── MTN Mobile Money (Uganda) ─────────────────────────────────────
MTN_API_KEY=
MTN_API_SECRET=
MTN_COLLECTION_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=
MTN_TARGET_ENVIRONMENT=sandbox   # change to production when live

# ── Airtel Money (Uganda) ─────────────────────────────────────────
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=https://openapi.airtel.africa
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX

# ── SMS (Africa's Talking recommended for Uganda) ─────────────────
SMS_PROVIDER=africas_talking
SMS_API_KEY=
SMS_USERNAME=sandbox
SMS_SENDER_ID=iCube

# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Platform domain ───────────────────────────────────────────────
# Your main platform domain — tenant subdomains are: {slug}.PLATFORM_DOMAIN
PLATFORM_DOMAIN=icubeug.net
