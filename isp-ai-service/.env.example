# .env.example — copy to .env and fill in your values

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL (your main ISP database)
DATABASE_URL=postgresql://isp_user:password@localhost:5432/isp_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT (must match your main API gateway secret)
JWT_SECRET=your-strong-secret-here

# Service port
PORT=3001
